{
  "expo": {
    "name": "Gluca",
    "slug": "gluca",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#101412",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101412"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101412",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": { "web": false } }],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow Gluca to save your exported graphic.",
          "photosPermission": "Allow Gluca to save a graphic you explicitly export."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Gluca to use a photo you choose as the background of a graphic. The photo stays on this device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "gluca"
  }
}
