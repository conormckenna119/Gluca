# Gluca backend settings. Copy to .env and fill in. Never commit .env.
# Leave the Dexcom values empty to run in mock mode (Dexcom routes answer 503).

# From your Dexcom developer portal app (sandbox only for now).
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
# Must end with /api/dexcom/callback and match the redirect URI registered with Dexcom.
DEXCOM_REDIRECT_URI=
# Only the sandbox is allowed (empty = https://sandbox-api.dexcom.com, sandbox); anything else is refused.
DEXCOM_API_BASE_URL=
DEXCOM_ENVIRONMENT=
# Web app and API must share an origin for the browser-bound callback.
# Default http://localhost:3000. A tunnel needs its actual assigned HTTPS origin here.
APP_BASE_URL=
BACKEND_PORT=
# Serve only the Expo web export in dist/ alongside /api, on the existing backend.
# Set true for browser OAuth testing; build once with EXPO_PUBLIC_FLAGS=dexcomApi first.
SERVE_WEB=false
# Stage 3: opt-in development-only authenticated data relay. Also requires a --dev web export
# built with EXPO_PUBLIC_FLAGS=dexcomApi,dexcomDiagnostics,dexcomSync for Stage 5.
# Never enable on public hosting. These flags are not secrets.
ENABLE_DEXCOM_DIAGNOSTICS=false
NODE_ENV=development
# 32 random bytes, base64. PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Signs the session cookie. PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# SQLite file, relative to the project root (empty = server/data/gluca.sqlite).
DATABASE_PATH=

# Browser UI feature flag, not a secret. Set at build time when testing OAuth.
# Leave off for the ordinary local demo (zero connection-service requests).
# EXPO_PUBLIC_FLAGS=dexcomApi

# Older placeholders from before the Dexcom backend; unused. Never put a service-role key, Dexcom client secret or tokens in EXPO_PUBLIC_*.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
